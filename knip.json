{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{ts,mjs}",
        "tests/**/*.ts"
      ],
      "project": [
        "scripts/**/*.{ts,mjs}",
        "tests/**/*.ts"
      ]
    },
    "apps/governor": {
      "entry": [
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "apps/runner": {
      "entry": [
        "src/main.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/launcher": {
      "entry": [
        "src/main.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/store": {
      "entry": [
        "src/main.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/web": {
      "project": [
        "src/**/*.{ts,tsx,css}"
      ]
    },
    "packages/contracts": {
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "tail"
  ],
  "ignoreDependencies": [
    "@tailwindcss/forms",
    "@tailwindcss/typography",
    "lucide-static"
  ]
}
