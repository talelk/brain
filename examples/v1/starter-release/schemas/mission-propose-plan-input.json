{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9.-]*$"
            }
          },
          "criterionIds": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "assignment": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "human",
                  "agent",
                  "workflow"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "role": {
                "enum": [
                  "coordinator",
                  "specialist",
                  "reviewer",
                  "synthesizer"
                ]
              }
            },
            "required": [
              "kind",
              "id",
              "role"
            ],
            "additionalProperties": false
          },
          "workflowId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "optional": {
            "type": "boolean"
          },
          "estimatedMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10080
          }
        },
        "required": [
          "id",
          "title",
          "criteria",
          "dependsOn"
        ],
        "additionalProperties": false
      }
    },
    "team": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "agentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "engine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9.-]*$"
          }
        },
        "required": [
          "memberId",
          "role",
          "agentId",
          "engine"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tasks"
  ],
  "additionalProperties": false
}
