{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "enum": [
        "docker.ps",
        "docker.logs",
        "docker.stats",
        "docker.df",
        "host.df",
        "host.memory",
        "host.uptime",
        "host.du",
        "systemd.is-active",
        "systemd.status",
        "http.head-local",
        "http.head-public"
      ]
    },
    "args": {
      "type": "object",
      "maxProperties": 3,
      "additionalProperties": {
        "type": "string",
        "maxLength": 80
      }
    }
  },
  "required": [
    "command"
  ],
  "additionalProperties": false
}
