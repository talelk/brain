{
  "apiVersion": "brain.keyrus/v1",
  "kind": "BrainConfig",
  "metadata": {
    "id": "example-brainconfig",
    "version": "1.0.0"
  },
  "spec": {
    "defaultPolicy": {
      "id": "strict-default",
      "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "maxConcurrentJobs": 12,
    "leaseSeconds": 60,
    "heartbeatSeconds": 15,
    "memoryRequired": false
  }
}
