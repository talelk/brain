{
  "title": "agent.toml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "default": [
        "pi",
        "claude"
      ],
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      }
    },
    "native": {
      "default": "none",
      "type": "string",
      "enum": [
        "none",
        "read",
        "all"
      ]
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "model_in_commands": {
      "default": false,
      "type": "boolean"
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "turns": {
          "default": 100,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens": {
          "default": 2000000,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "spend_usd": {
          "default": 0,
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "translations": {
      "type": "object",
      "properties": {
        "fr": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "ar": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "description"
  ],
  "additionalProperties": false
}
