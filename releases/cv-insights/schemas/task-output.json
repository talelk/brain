{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "deliverable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40000
    },
    "criteria": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "met": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "criterion",
          "met",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "required": [
    "summary",
    "deliverable",
    "criteria",
    "assumptions"
  ],
  "additionalProperties": false
}
