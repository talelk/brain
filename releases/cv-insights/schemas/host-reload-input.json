{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_@-]{0,79}$"
    }
  },
  "required": [
    "service"
  ],
  "additionalProperties": false
}
