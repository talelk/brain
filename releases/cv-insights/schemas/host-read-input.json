{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "list",
        "read",
        "find"
      ]
    },
    "path": {
      "type": "string",
      "maxLength": 400
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    }
  },
  "required": [
    "op"
  ],
  "additionalProperties": false
}
