{
  "name": "brain-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.typecheck.json",
    "typecheck:web": "pnpm --filter @brain/web typecheck",
    "lint": "eslint . --max-warnings 0",
    "check:biome": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "check:knip": "knip --no-config-hints",
    "test:unit": "node scripts/with-tmpdir.mjs vitest run tests/unit",
    "test:core": "node scripts/with-tmpdir.mjs vitest run tests/core",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:core",
    "build": "pnpm --filter @brain/web build",
    "host-watchdog": "tsx scripts/watchdog/host-watchdog.ts",
    "brain": "tsx scripts/brain.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.1",
    "better-sqlite3": "13.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-solid": "0.18.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "isomorphic-git": "1.44.8",
    "knip": "6.43.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
