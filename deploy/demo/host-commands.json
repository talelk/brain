{
  "commands": {
    "host.status": {
      "effect": "read",
      "argv": ["docker", "ps", "-a", "--format", "{{.Names}}\t{{.Image}}\t{{.Status}}"]
    },
    "host.logs": {
      "effect": "read",
      "argv": ["docker", "logs", "--tail", "{lines}", "{container}"],
      "args": {
        "lines": "^([1-9][0-9]?|[1-4][0-9]{2}|500)$",
        "container": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$"
      },
      "timeoutMs": 30000
    },
    "host.disk": {
      "effect": "read",
      "argv": ["df", "-h"]
    },
    "host.restart": {
      "effect": "privileged",
      "argv": ["docker", "restart", "{container}"],
      "args": {
        "container": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$"
      },
      "timeoutMs": 90000
    },
    "host.redeploy": {
      "effect": "privileged",
      "argv": ["docker", "compose", "--project-directory", "/srv/demos/{stack}", "up", "-d", "--pull", "always"],
      "args": {
        "stack": "^(?!brain$)[a-z0-9][a-z0-9_-]{0,62}$"
      },
      "timeoutMs": 300000
    }
  }
}
