[Unit]
Description=Keyrus Brain standing test set (fixture tasks against the self-hosted model)
After=network-online.target

[Service]
Type=oneshot
User=talel
WorkingDirectory=/srv/demos/brain/src
EnvironmentFile=/srv/demos/brain/runner-agents.env
# Exit 3 means no model was reachable: the run was skipped, which is not a failure of the unit.
SuccessExitStatus=3
ExecStart=/usr/bin/pnpm exec tsx scripts/standing-tests/run.ts
