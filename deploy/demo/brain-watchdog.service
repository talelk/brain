[Unit]
Description=Keyrus Brain host watchdog (restarts a launcher, runner or model proxy that stopped answering)
After=network-online.target

[Service]
Type=oneshot
User=talel
WorkingDirectory=/srv/demos/brain/src
Environment=BRAIN_WATCHDOG_STATE=/srv/demos/brain/run/watchdog-state.json
ExecStart=/usr/bin/pnpm exec tsx scripts/watchdog/host-watchdog.ts
