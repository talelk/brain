# Brain monorepo ignores — secrets and runtime state never enter Git
node_modules/
dist/
build/
coverage/
test-results/
playwright-report/
.turbo/
*.tsbuildinfo

# Secrets
.env
.env.*
!.env.example
**/secrets/
*.pem
*.key

# Runtime data (SQLite, WAL, spools, artifacts) — anchored so source trees
# like apps/web/src/data/ are never swallowed.
/data/
/state/
/spool/
/tmp/
*.db
*.db-shm
*.db-wal
artifacts/runtime/**/raw/

# Local agent/test state (session logs, checkpoints, caches)
.pi-agent/
.vitest/

# OS / editor
.DS_Store
.idea/
.vscode/
__pycache__/
*.pyc
.zcode/
