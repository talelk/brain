  "rules": [
    "Every transition checks expected version and emits audit/outbox atomically.",
    "Approval consumption is a separate immutable ledger entry, not a resettable approval state.",
    "Unknown outcome resolution requires reconciler evidence and authorized decision.",
    "Retry creates a new attempt; no terminal attempt returns to running.",
    "Runner admin/connectivity/allocation/health are independent axes."
  ],
  "transitionGuards": {
    "job.running->queued": "Only a classified retryable failed attempt with no unresolved effect, bounded attempts/deadline, backoff and fresh admission; never reverse a terminal attempt.",
    "job.blocked->queued": "Explicit recovery reason; all effect guards reconciled and policy allows reexecution; otherwise resume verification instead of rerunning effects.",
    "job.outcome_unknown->terminal": "Target-specific reconciliation evidence plus accepted verifier/authorized resolution; no generic retry.",
    "approval.pending->approved": "Current authenticated human/step-up, exact displayed digest, separation of duties and unexpired current version.",
    "evidence.submitted->verified": "Pinned independent evaluator, immutable bytes, all required criteria and external effects accepted."
  }
