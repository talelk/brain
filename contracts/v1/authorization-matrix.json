{
  "contractVersion": "brain.authorization-matrix/v1",
  "default": "deny",
  "roleInheritance": false,
  "workspaceReadRequiresMembership": true,
  "roles": {
    "viewer": {
      "scopes": [
        "workspace:read"
      ],
      "grantScope": "workspace"
    },
    "operator": {
      "scopes": [
        "workspace:read",
        "workflow:dispatch",
        "workflow:cancel",
        "session:steer",
        "session:stop",
        "board:write",
        "tool:propose",
        "approval:request",
        "job:reconcile",
        "decision:write"
      ],
      "grantScope": "workspace"
    },
    "workspace-lead": {
      "scopes": [
        "workspace:read",
        "workflow:dispatch",
        "workflow:cancel",
        "session:steer",
        "session:stop",
        "board:write",
        "tool:propose",
        "approval:request",
        "job:reconcile",
        "workspace:admin",
        "workspace:export",
        "memory:publish",
        "approval:revoke",
        "decision:write",
        "members:read"
      ],
      "grantScope": "workspace"
    },
    "approver": {
      "scopes": [
        "workspace:read",
        "approval:decide",
        "approval:revoke"
      ],
      "grantScope": "workspace"
    },
    "organization-admin": {
      "scopes": [
        "config:activate",
        "workspace:import",
        "runner:admin",
        "members:read",
        "audit:read",
        "membership:grant",
        "membership:revoke",
        "identity:read",
        "identity:manage",
        "identity:security",
        "platform:read"
      ],
      "grantScope": "organization"
    },
    "security-admin": {
      "scopes": [
        "runner:security",
        "memory:admin",
        "approval:revoke",
        "audit:read",
        "membership:revoke",
        "identity:read",
        "identity:security",
        "platform:read"
      ],
      "grantScope": "organization"
    },
    "tool-publisher": {
      "scopes": [
        "tool:publish"
      ],
      "grantScope": "organization"
    }
  },
  "specialEndpoints": {
    "approval.decision": {
      "scope": "approval:decide",
      "humanOnly": true,
      "freshStepUpForHighRisk": true,
      "actors": [
        "human"
      ]
    },
    "approval.decision-status": {
      "scope": "workspace:read",
      "actors": [
        "human"
      ],
      "originalActorOnly": true,
      "currentMembershipRequired": true
    },
    "task.prepare": {
      "scope": "workflow:dispatch",
      "actors": [
        "human",
        "agent",
        "workflow"
      ],
      "currentMembershipRequired": true,
      "scopeMode": "workspace",
      "originalActorOnly": false
    },
    "task.start": {
      "scope": "workflow:dispatch",
      "actors": [
        "human",
        "agent",
        "workflow"
      ],
      "currentMembershipRequired": true,
      "scopeMode": "workspace",
      "originalActorOnly": true
    },
    "conversation.create": {
      "scope": "workflow:dispatch",
      "actors": [
        "human",
        "agent",
        "workflow"
      ],
      "currentMembershipRequired": true,
      "scopeMode": "workspace",
      "originalActorOnly": true
    },
    "conversation.message": {
      "scope": "workflow:dispatch",
      "actors": [
        "human",
        "agent",
        "workflow"
      ],
      "currentMembershipRequired": true,
      "scopeMode": "workspace",
      "originalActorOnly": true
    },
    "task.get": {
      "scope": "workspace:read",
      "actors": [
        "human",
        "agent",
        "workflow"
      ],
      "currentMembershipRequired": true,
      "originalActorOnly": true,
      "scopeMode": "workspace"
    },
    "conversation.get": {
      "scope": "workspace:read",
      "actors": [
        "human",
        "agent",
        "workflow"
      ],
      "currentMembershipRequired": true,
      "originalActorOnly": true,
      "scopeMode": "workspace"
    },
    "conversation.list": {
      "scope": "workspace:read",
      "actors": [
        "human",
        "agent",
        "workflow"
      ],
      "currentMembershipRequired": true,
      "originalActorOnly": true,
      "scopeMode": "workspace"
    },
    "task.context": {
      "scope": "workspace:read",
      "actors": [
        "human",
        "agent",
        "workflow"
      ],
      "currentMembershipRequired": true,
      "scopeMode": "workspace"
    },
    "plan.prepare": {
      "scope": "workflow:dispatch",
      "actors": ["human", "agent", "workflow"],
      "currentMembershipRequired": true,
      "scopeMode": "workspace",
      "originalActorOnly": false
    },
    "plan.get": {
      "scope": "workspace:read",
      "actors": ["human", "agent", "workflow"],
      "currentMembershipRequired": true,
      "originalActorOnly": true,
      "scopeMode": "workspace"
    },
    "diagnostics.export": {
      "scope": "config:activate",
      "additionalScopes": [
        "runner:admin"
      ],
      "actors": [
        "human"
      ],
      "humanOnly": true,
      "currentMembershipRequired": true
    },
    "local-runtime.get": {
      "scope": "config:activate",
      "additionalScopes": [
        "runner:admin"
      ],
      "actors": [
        "human"
      ],
      "humanOnly": true,
      "currentMembershipRequired": true
    },
    "local-runtime.connect": {
      "scope": "config:activate",
      "additionalScopes": [
        "runner:admin"
      ],
      "actors": [
        "human"
      ],
      "humanOnly": true,
      "currentMembershipRequired": true,
      "requireFactorWhenConfigured": true
    },
    "runner.tokens": {
      "scope": "runner:admin",
      "actors": [
        "human"
      ],
      "humanOnly": true,
      "requireFactorWhenConfigured": true,
      "currentMembershipRequired": true
    }
  },
  "separationOfDuties": "request author cannot approve own high-risk effect; organization administration grants no bypass",
  "commandPolicySource": "contracts/v1/registry.json",
