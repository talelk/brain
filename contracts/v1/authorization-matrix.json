  "commandRecoveryRule": {
    "query": "command.get",
    "sameOriginalActorAllowed": true,
    "otherwiseScope": "workspace:read",
    "requireCurrentAuthorization": true,
    "crossTenantLookup": "deny"
  },
  "evaluationOrder": [
    "authenticate-server-principal",
    "current-organization-membership",
    "operation-exists-and-actor-kind-allowed",
    "resolve-current-scope-and-membership",
    "require-explicit-role-or-intersected-delegated-capability",
    "current-policy-and-revocation",
    "exact-step-up-and-separation-of-duties-when-required"
