{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-qwen/qwen3.8-flash-next-a5b",
  "default_agent": "brain-implementer",
  "instructions": [
    "/home/talel/.codex/RTK.md",
    "IMPLEMENTATION_PROMPT.md",
    "docs/implementation/17-opencode-execution.md"
  ],
  "compaction": {
    "auto": true,
    "keep": { "tokens": 16000 },
    "buffer": 40000
  },
  "agents": {
    "brain-implementer": {
      "description": "Implement the current Brain target using verified contracts, the coverage ledger and real acceptance evidence.",
      "mode": "primary",
      "model": "local-qwen/qwen3.8-flash-next-a5b",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "rtk *", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "**/.env*", "effect": "deny" },
        { "action": "edit", "resource": "**/secrets/*", "effect": "deny" },
        { "action": "read", "resource": "**/.env*", "effect": "deny" },
        { "action": "read", "resource": "**/secrets/*", "effect": "deny" }
      ]
    }
  }
}
