{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "declaration": false,
    "paths": {
      "@brain/contracts": ["./packages/contracts/src/index.ts"],
      "@brain/contracts/limits": ["./packages/contracts/src/limits.ts"],
      "@brain/contracts/packs": ["./packages/contracts/src/packs.ts"]
    }
  },
  "include": ["packages/contracts/src", "apps/governor/src", "apps/governor/scripts", "apps/runner/src", "apps/launcher/src", "apps/store/src", "apps/mcp/src", "tests", "scripts/*.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "**/dist"]
}
